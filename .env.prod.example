# Production settings for docker-compose.prod.yml. Copy to .env on the server (never commit it):
#   cp .env.prod.example .env && chmod 600 .env
# Generate secrets with:  openssl rand -base64 48

# --- Site ---
DOMAIN=beestore.vn
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token (the long string after --token).
# Public hostname in the dashboard: HTTP  proxy:80
TUNNEL_TOKEN=
# Loopback port for checking the site from the server itself (curl http://127.0.0.1:8088)
PROXY_PORT=8088

# --- Database (internal to Docker, never published) ---
DB_NAME=beestore
DB_USER=beestore
DB_PASSWORD=change-me-long-random

# --- Security ---
JWT_SECRET=change-me-at-least-32-bytes-random
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
JWT_REFRESH_TTL_REMEMBER=P30D
# Required in production: guest quote requests fail closed without it (README §20)
TURNSTILE_SECRET=

# --- Mail (real SMTP provider, e.g. Resend / Brevo / SES) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Bee Store <no-reply@beestore.vn>"
SALES_NOTIFY_EMAIL=sales@beestore.vn
SALES_NOTIFY_WEBHOOK=

# --- Next.js on-demand revalidation (optional until the FE route exists) ---
REVALIDATE_URL=
REVALIDATE_SECRET=

# --- First admin, created on first start only ---
ADMIN_BOOTSTRAP_EMAIL=admin@beestore.vn
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong

# --- Backups (infra/scripts/backup.sh) ---
BACKUP_DIR=/opt/beestore/backups
# Optional: encrypt dumps for this GPG recipient, and copy them off the server with rclone
BACKUP_GPG_RECIPIENT=
BACKUP_RCLONE_REMOTE=
